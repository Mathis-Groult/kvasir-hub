{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kvasir",
  "version": "0.1.0",
  "identifier": "win.kv4sir.hub",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Kvasir",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Every Kvasir app in one place",
    "linux": { "deb": { "depends": [] } }
  }
}
